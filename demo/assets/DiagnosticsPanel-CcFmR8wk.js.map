import { useEffect, useState } from 'react';
import {
  AlertTriangle,
  EyeOff,
  Info,
  Lightbulb,
  SearchX,
  ShieldCheck,
} from 'lucide-react';
import { api } from '../lib/api';
import type { BlindspotCategory, BlindspotsResponse, ClaimVerdictsResponse } from '../types';
import NewHereHint from './NewHereHint';
import { EmptyState } from './EmptyState';

/**
 * Diagnostics prototype: the transfer flaws the optimizer cannot see.
 *
 * The optimizer only ever connects a rider to the NEXT departure within its
 * 22-min search window, so it can't represent two real experiences:
 *   1. "Hidden" waits — the next bus is 25-60 min away (dropped before modeling).
 *   2. "Just missed" — you arrive a minute after the bus left, so you wait a
 *      full headway.
 * This panel surfaces those rows and says whether a ±5 min shift could fix them.
 */

interface Props {
  period: string;
}

const CATEGORY_META: Record<
  BlindspotCategory,
  { label: string; icon: typeof Info; accent: string; desc: string }
> = {
  modeled: {
    label: 'Visible today',
    icon: ShieldCheck,
    accent: 'text-optimized',
    desc: 'What the current tools already report.',
  },
  hidden: {
    label: 'Hidden long waits',
    icon: EyeOff,
    accent: 'text-bottleneck',
    desc: 'Next bus is >22 min away — the optimizer drops these before it ever sees them.',
  },
  just_missed: {
    label: 'Just missed the bus',
    icon: SearchX,
    accent: 'text-danger',
    desc: 'You arrived right after the previous bus left, so you wait the full time between buses.',
  },
};

function fmt(mins: number | null): string {
  return mins == null ? '—' : `${mins.toFixed(1)} min`;
}

function routeLabel(route: string, direction: string): string {
  return direction ? `Route ${route} ${direction}` : `Route ${route}`;
}

interface SwarmScoreboardEntry {
  combo: string;
  scored: number;
  accept_rate: number;
  p50: number;
  p90: number;
}

interface SwarmScoreboardPayload {
  entries?: SwarmScoreboardEntry[];
  error?: string;
}

export default function DiagnosticsPanel({ period }: Props) {
  const [volumeMode, setVolumeMode] = useState('ridership');
  const [data, setData] = useState<BlindspotsResponse | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [reloadKey, setReloadKey] = useState(0);
  const [claims, setClaims] = useState<ClaimVerdictsResponse | null>(null);
  const [claimsBusy, setClaimsBusy] = useState(false);
  const [swarmScoreboard, setSwarmScoreboard] = useState<SwarmScoreboardPayload | null>(null);
  const [swarmBusy, setSwarmBusy] = useState(false);
  const [collectorStatus, setCollectorStatus] = useState<{ ok: boolean; stale: boolean; age_s: number | null; fresh_after_s: number; ts: string | null } | null>(null);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      setError(null);
      try {
        const d = await api.transferBlindspots({
          period,
          volume_mode: volumeMode,
          limit: 200,
          max_per_departing_route: 8,
        });
        if (!cancelled) setData(d);
      } catch (e) {
        if (!cancelled) setError(e instanceof Error ? e.message : String(e));
      }
    })();
    return () => {
      cancelled = true;
    };
  }, [period, volumeMode, reloadKey]);

  // Claim-check verdicts (T90): independent of the main diagnostics fetch so
  // an audit problem can never break the panel.
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const d = await api.claimVerdicts();
        if (!cancelled) setClaims(d);
      } catch (e) {
        if (!cancelled)
          setClaims({ no_audit_yet: true, detail: e instanceof Error ? e.message : String(e) });
      }
    })();
    return () => {
      cancelled = true;
    };
  }, []);

useEffect(() => {
     let cancelled = false;
     (async () => {
       setSwarmBusy(true);
       try {
         const res = await fetch('/api/swarm-scoreboard');
         const d = await res.json();
         if (!cancelled) {
           if (res.ok) {
             setSwarmScoreboard(d);
           } else {
             setSwarmScoreboard({ error: d.detail || 'proxy unavailable' });
           }
         }
       } catch (e) {
         if (!cancelled) setSwarmScoreboard({ error: 'proxy unavailable' });
       } finally {
         setSwarmBusy(false);
       }
     })();
     return () => {
       cancelled = true;
     };
   }, []);

   // Fetch collector status on mount
   useEffect(() => {
     let cancelled = false;
     (async () => {
       try {
         const res = await fetch('/api/collector-status');
         if (res.ok) {
           const d = await res.json();
           if (!cancelled) setCollectorStatus(d);
         }
         // Note: We don't set error state for collector status failures
         // as we just want to show the banner, not break the panel
       } catch (e) {
         // Ignore fetch errors - we'll show stale/missing banner
         if (!cancelled) setCollectorStatus({ ok: false, stale: true, age_s: null, fresh_after_s: 1800, ts: null });
       }
     })();
     return () => {
       cancelled = true;
     };
   }, []);

  const refreshClaims = async () => {
    setClaimsBusy(true);
    try {
      const d = await api.refreshClaimVerdicts();
      setClaims(d);
    } catch (e) {
      setClaims({ no_audit_yet: true, detail: e instanceof Error ? e.message : String(e) });
    } finally {
      setClaimsBusy(false);
    }
  };

if (error) {
     return (
       <div className="flex-1 overflow-y-auto p-4">
         <EmptyState
           reason={`Couldn't load diagnostics: ${error}`}
           onRetry={() => setReloadKey((k) => k + 1)}
         />
       </div>
     );
   }

   // Collector status banner (conditionally rendered)
   let bannerContent = null;
   if (collectorStatus !== null) {
     if (!collectorStatus.ok) {
       bannerContent = (
         <div className="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-4 flex items-center gap-3">
           <AlertTriangle className="h-5 w-5 text-amber-400 shrink-0" />
           <div className="text-sm text-amber-800">
             Collector heartbeat stale — age {collectorStatus.age_s === null ? 'unknown' : `${Math.round(collectorStatus.age_s / 60)}m`}
           </div>
         </div>
       );
     } else if (collectorStatus.stale) {
       bannerContent = (
         <div className="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-4 flex items-center gap-3">
           <AlertTriangle className="h-5 w-5 text-amber-400 shrink-0" />
<div className="text-sm text-amber-800">
              Collector heartbeat stale — age {collectorStatus.age_s === null ? 'unknown' : `${Math.round(collectorStatus.age_s / 60)}m`}
            </div>
         </div>
       );
     }
     // For fresh status, we show no banner (could add a subtle green dot if desired)
   }

   if (!data) {
     return (
       <div className="flex-1 overflow-y-auto p-4">
         {bannerContent && <div className="p-4">{bannerContent}</div>}
         <div className="animate-pulse rounded-xl border border-border bg-card p-4 text-xs text-text-muted">
           Scanning the transfer network…
         </div>
       </div>
     );
   }

const s = data.summary;

   return (
     <div className="flex-1 overflow-y-auto p-4">
       {bannerContent && <div className="p-4">{bannerContent}</div>}
       <div className="mx-auto max-w-3xl space-y-4">
         <NewHereHint text="The optimizer only sees connections within a short look-ahead window. This scan widens the search to expose waits riders actually experience that the optimizer misses." />

        {/* volume mode selector */}
        <section className="flex items-center gap-3 rounded-xl border border-border bg-card px-4 py-2.5">
          <label className="text-xs font-semibold text-text-secondary" htmlFor="volume-mode">
            Volume mode
          </label>
          <select
            id="volume-mode"
            value={volumeMode}
            onChange={(e) => setVolumeMode(e.target.value)}
            className="rounded border border-border bg-card-hover px-2 py-1 text-xs text-text-primary"
          >
            <option value="ridership">Ridership</option>
            <option value="measured">Measured</option>
            <option value="estimated">Estimated</option>
            <option value="uniform">Uniform</option>
          </select>
        </section>

        {/* intro */}
        <section className="rounded-xl border border-amber-500/40 bg-card p-4">
          <div className="flex items-center gap-2 text-xs font-semibold text-amber-400">
            <AlertTriangle className="h-4 w-4" />
            Transfer blind spots — prototype diagnostic
          </div>
          <p className="mt-2 text-[11px] leading-relaxed text-text-muted">
            The optimizer only looks{' '}
            <span className="text-text-primary">{data.default_window_minutes} min</span> ahead when
            matching transfers (buffer {data.buffer_minutes} + t_max {data.t_max} + shift rescue).
            Connections whose next bus is farther out are <em>dropped before they are modeled</em>.
            This scan widens the horizon to{' '}
            <span className="text-text-primary">{data.search_horizon_minutes} min</span> to expose
            what riders actually feel — then flags what a ±5 min shift could fix.
          </p>
        </section>

        {/* summary tiles */}
        <section className="grid grid-cols-2 gap-3">
<StatTile
  label="Damage the tools see"
  value={`${s.modeled.toLocaleString()} (n=${data.summary.n.toLocaleString()})`}
  sub={`${data.summary.total_damaging.toLocaleString()} total problematic connections`}
  accent="text-optimized"
/>
<StatTile
  label="Hidden long waits"
  value={`${s.hidden.toLocaleString()} (n=${data.summary.n.toLocaleString()})`}
  sub="dropped before the model ever runs"
  accent="text-bottleneck"
/>
<StatTile
  label="Just-missed the bus"
  value={`${s.just_missed.toLocaleString()} (n=${data.summary.n.toLocaleString()})`}
  sub="arrived moments after the bus left"
  accent="text-danger"
/>
<StatTile
  label="Worst hidden wait"
  value={`${fmt(s.worst_wait_minutes)} (n=${data.summary.n.toLocaleString()})`}
  sub={s.worst_headway_minutes ? `vs a ${fmt(s.worst_headway_minutes)} time between buses` : '—'}
  accent="text-amber-400"
/>
<StatTile
  label="Fixable with ±5 min shift"
  value={`${s.shiftable_within_max.toLocaleString()} (n=${data.summary.n.toLocaleString()})`}
  sub="a schedule nudge would bring these under t_max"
  accent="text-accent"
/>
<StatTile
  label="Not fixable by shifting"
  value={`${s.not_shiftable.toLocaleString()} (n=${data.summary.n.toLocaleString()})`}
  sub="needs frequency / routing change"
  accent="text-text-secondary"
/>
        </section>

        {/* how to read */}
        <section className="flex flex-col gap-1.5">
          {(Object.keys(CATEGORY_META) as BlindspotCategory[]).map((k) => {
            const m = CATEGORY_META[k];
            const Icon = m.icon;
            return (
              <div key={k} className="flex items-start gap-2 rounded-lg bg-card-hover px-3 py-2">
                <Icon className={`mt-0.5 h-4 w-4 shrink-0 ${m.accent}`} />
                <div>
                  <span className={`text-xs font-semibold ${m.accent}`}>{m.label}</span>
                  <p className="text-[10px] leading-snug text-text-muted">{m.desc}</p>
                </div>
              </div>
            );
          })}
        </section>

        {/* claim checks (T90) — verdicts from check_claim.py --batch */}
        {claims && (
          <section className="rounded-xl border border-border bg-card">
            <div className="flex items-center justify-between border-b border-border px-4 py-3">
              <div className="flex items-center gap-2 text-xs font-semibold text-text-secondary">
                <ShieldCheck className="h-4 w-4 text-optimized" />
                Claim checks — route-serves-place verdicts
                {claims.total != null && (
                  <span className="rounded-full bg-card-hover px-2 py-0.5 text-[10px] font-semibold text-text-muted">
                    n={claims.total}
                  </span>
                )}
              </div>
              <button
                onClick={() => void refreshClaims()}
                disabled={claimsBusy}
                className="rounded-md bg-card-hover px-2 py-1 text-[10px] font-semibold text-text-secondary transition-colors hover:opacity-90 disabled:opacity-50"
              >
                {claimsBusy ? 'Auditing…' : 'Refresh audit'}
              </button>
            </div>
            {claims.no_audit_yet ? (
              <p className="px-4 py-4 text-[11px] text-text-muted">
                No claim audit yet — run the batch claim check to verify route-serves-place
                statements in the docs.
                {claims.detail ? ` (${claims.detail})` : ''}
              </p>
            ) : (
              <ul className="divide-y divide-border">
                {(claims.results ?? []).map((r, i) => (
                  <li key={`${r.source}-${i}`} className="flex items-start justify-between gap-3 px-4 py-2.5">
                    <div className="min-w-0">
                      <p className="text-[11px] font-semibold text-text-primary">
                        Route {r.route} serves “{r.place}”
                      </p>
                      <p className="truncate text-[10px] text-text-muted" title={r.evidence}>
                        {r.source} · {r.evidence}
                      </p>
                    </div>
                    <span
                      className={`shrink-0 rounded-full px-2 py-0.5 text-[10px] font-semibold ${
                        r.verdict === 'PASS' ? 'bg-optimized/10 text-optimized' : 'bg-danger/10 text-danger'
                      }`}
                    >
                      {r.verdict}
                    </span>
                  </li>
                ))}
                {(claims.results ?? []).length === 0 && (
                  <li className="px-4 py-4 text-[11px] text-text-muted">
                    No quoted claims found in .agents//docs/ — nothing to verify.
                  </li>
                )}
              </ul>
            )}
          </section>
        )}

        {/* swarm lane scoreboard */}
        {swarmScoreboard ? (
          swarmScoreboard.error ? (
            <p className="px-4 py-4 text-[11px] text-text-muted">
              proxy unavailable
            </p>
          ) : (
            <section className="rounded-xl border border-border bg-card">
              <div className="flex items-center justify-between border-b border-border px-4 py-3 text-xs font-semibold text-text-secondary">
                <Lightbulb className="h-4 w-4 text-amber-400" />
                Swarm lane scoreboard{swarmBusy ? ' …' : ''}
              </div>
              <div className="overflow-x-auto">
                <table className="min-w-full bg-card">
                  <thead>
                    <tr className="text-xs font-semibold text-text-secondary border-b border-border">
                      <th className="p-2">combo</th>
                      <th className="p-2">scored</th>
                      <th className="p-2">accept rate</th>
                      <th className="p-2">p50</th>
                      <th className="p-2">p90</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(swarmScoreboard.entries ?? []).sort((a, b) => b.scored - a.scored).map((entry, i) => (
                      <tr key={`${entry.combo}-${i}`} className="text-[10px] border-b border-border">
                        <td className="p-2 text-text-primary">{entry.combo}</td>
                        <td className="p-2">{entry.scored}</td>
                        <td className="p-2">{(entry.accept_rate * 100).toFixed(1)}%</td>
                        <td className="p-2">{entry.p50.toFixed(1)} min</td>
                        <td className="p-2">{entry.p90.toFixed(1)} min</td>
                      </tr>
                    ))}
                    {(swarmScoreboard.entries ?? []).length === 0 && (
                      <tr>
                        <td className="p-4 text-text-muted" colSpan={5}>
                          No swarm scoreboard data available
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          )
        ) : null}

        {/* connections */}
        <section className="rounded-xl border border-border bg-card">
          <div className="flex items-center gap-2 border-b border-border px-4 py-3 text-xs font-semibold text-text-secondary">
            <Lightbulb className="h-4 w-4 text-amber-400" />
            Worst hidden & just-missed connections
          </div>
          {data.connections.filter((c) => c.category !== 'modeled').length === 0 ? (
            <div className="px-4 py-6">
              <EmptyState
                reason="No hidden or just-missed connections found — every problematic transfer is already visible to the optimizer."
                onRetry={() => setReloadKey((k) => k + 1)}
              />
            </div>
          ) : (
          <ul className="divide-y divide-border">
            {data.connections
              .filter((c) => c.category !== 'modeled')
              .slice(0, 50)
              .map((c, i) => {
                const m = CATEGORY_META[c.category] ?? {
                  label: c.category ?? 'other',
                  accent: 'text-text-secondary',
                };
                return (
                  <li key={`${c.stop_id}-${c.route_i}-${c.route_j}-${c.arr_time}-${i}`} className="px-4 py-3">
                    <div className="flex flex-wrap items-center justify-between gap-2">
                      <span className="text-xs font-semibold text-text-primary">
                        {routeLabel(c.route_i, c.direction_i)} →{' '}
                        {routeLabel(c.route_j, c.direction_j)}
                      </span>
                      <span className={`rounded-full bg-card-hover px-2 py-0.5 text-[10px] font-semibold ${m.accent}`}>
                        {m.label}
                      </span>
                    </div>
                    <p className="mt-1 text-[11px] text-text-muted">
                      {c.stop_name} · arrive {c.arr_time}
                      {c.prev_dep_time ? (
                        <>
                          {' '}· <span className="text-danger">previous bus left {c.prev_dep_time}</span>
                        </>
                      ) : null}
                    </p>
                    <div className="mt-2 flex flex-wrap items-center gap-1.5 text-[10px]">
                      <span className="rounded bg-card-hover px-1.5 py-0.5 text-text-secondary">
                        wait <b className="text-text-primary">{c.wait_minutes.toFixed(0)} min</b>
                      </span>
                      <span className="rounded bg-card-hover px-1.5 py-0.5 text-text-secondary">
                        next bus every ~{c.headway_minutes.toFixed(0)} min
                      </span>
                      <span className="rounded bg-card-hover px-1.5 py-0.5 text-text-secondary">
                        rider impact {c.cost_minutes.toFixed(0)} rider-min
                      </span>
                    </div>
                    <div
                      className={`mt-2 rounded-lg px-2.5 py-1.5 text-[10px] leading-snug ${
                        c.shiftable_within_max
                          ? 'bg-optimized/10 text-optimized'
                          : 'bg-card-hover text-text-muted'
                      }`}
                    >
                      {c.shiftable_within_max ? (
                        <>
                          <ShieldCheck className="mr-1 inline h-3 w-3" />
                          A ±{Math.ceil(c.shift_to_fix_minutes ?? 1)} min shift would bring this
                          under the {data.t_max}-min cap — but the optimizer can't find it today.
                        </>
                      ) : (
                        <>
                          <Info className="mr-1 inline h-3 w-3" />
                          Needs {(c.shift_to_fix_minutes ?? 0) > 0 ? `~${Math.ceil(c.shift_to_fix_minutes ?? 0)}` : ''} min
                          — beyond the ±5 shift budget. This is a frequency/routing fix, not a nudge.
                        </>
                      )}
                    </div>
                  </li>
                );
              })}
          </ul>
          )}
        </section>
      </div>
    </div>
  );
}

function StatTile({
  label,
  value,
  sub,
  accent,
}: {
  label: string;
  value: string;
  sub: string;
  accent: string;
}) {
  return (
    <div className="rounded-xl border border-border bg-card p-3">
      <p className="text-[10px] uppercase tracking-wide text-text-muted">{label}</p>
      <p className={`mt-1 text-xl font-bold ${accent}`}>{value}</p>
      <p className="mt-0.5 text-[10px] leading-snug text-text-muted">{sub}</p>
    </div>
  );
}
